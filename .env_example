# Copy to .env, then fill in the pieces you use.
#
# This file holds shared infrastructure only. Per-person settings — Telegram ID,
# import source, Drive folder IDs — belong in ~/Documents/zdrowskit/profiles.toml.

# Provider keys. The built-in routes span OpenAI, DeepSeek, and Anthropic, so
# all three are needed for the defaults plus their fallbacks. See docs/llm.md
# before omitting one. `uv run python main.py models` prints the routes in
# effect for a profile; `main.py models doctor` reports keys missing for them.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Shared Telegram bot. Numeric user IDs belong in profiles.toml.
TELEGRAM_BOT_TOKEN=

# Shared path overrides.
# ZDROWSKIT_HOME=~/Documents/zdrowskit
# Names a second installation on the same machine — a lab running its own
# ZDROWSKIT_HOME and its own Telegram bot. Its launchd label, plist filename
# and log file all derive from this, so nothing collides with the live one.
# Lowercase letters, digits, '_' and '-'.
# ZDROWSKIT_INSTANCE=lab
# Log destination. Defaults to a name derived from ZDROWSKIT_INSTANCE; set it
# only to put the log somewhere other than the user's log directory.
# ZDROWSKIT_LOG_FILE=
# Public Funnel port. One mapping per port serves the whole machine, so a
# second instance that wants its own HTTP ingest must take a different one.
# ZDROWSKIT_FUNNEL_HTTPS_PORT=443
# Loopback receiver port. Also per-machine; give a second instance its own.
# ZDROWSKIT_HTTP_INGEST_PORT=8787
# Tailscale CLI, read for the node's own connection state. Absolute, because
# the daemon runs under launchd and does not inherit a shell PATH.
# ZDROWSKIT_TAILSCALE_BINARY=/usr/local/bin/tailscale
# macOS app restarted to reconnect a wedged Tailscale. Only the default
# installation ever does this; Tailscale is machine-wide.
# ZDROWSKIT_TAILSCALE_APP_NAME=Tailscale
# Local/iCloud source used by the operator profile.
# HEALTH_DATA_DIR=~/Library/Mobile Documents/iCloud~com~ifunography~HealthExport/Documents

# Shared Google Drive infrastructure. Each person's import source and folder
# IDs belong in profiles.toml.
# ZDROWSKIT_GOOGLE_DRIVE_SERVICE_ACCOUNT=~/Documents/zdrowskit/secrets/service-account.json
# ZDROWSKIT_GOOGLE_DRIVE_POLL_INTERVAL_S=300

# Workout locality lookup during import. Set to "off" to skip reverse geocoding.
# ZDROWSKIT_LOCATION_GEOCODER=nominatim
# ZDROWSKIT_LOCATION_COORD_DECIMALS=2
# ZDROWSKIT_LOCATION_MIN_REQUEST_INTERVAL_S=1.1
# ZDROWSKIT_LOCATION_USER_AGENT=zdrowskit/0.1 personal health import

# Model routing, token budgets, and verification switches are also settable
# here, but the defaults are not restated in this file: they move, and a stale
# copy here is worse than none. `src/config.py` carries every variable name,
# its default, and why the default is what it is. Prefer `main.py models` for
# routing changes — it persists per profile and survives an .env edit.

# Legacy single-profile values. Keep these only until `profile adopt NAME`
# has copied them into profiles.toml, then remove them.
# TELEGRAM_CHAT_ID=
# ZDROWSKIT_IMPORT_SOURCE=local
# ZDROWSKIT_GOOGLE_DRIVE_METRICS_FOLDER_ID=
# ZDROWSKIT_GOOGLE_DRIVE_WORKOUTS_FOLDER_ID=
