# Copy to .env, then fill in the pieces you use.
#
# Minimum for LLM reports: one provider key that matches your configured model.
# Defaults use DeepSeek for reports/nudges and Anthropic as fallback/chat.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Shared path overrides.
# ZDROWSKIT_HOME=~/Documents/zdrowskit
# Local/iCloud source used by the operator profile.
# HEALTH_DATA_DIR=~/Library/Mobile Documents/iCloud~com~ifunography~HealthExport/Documents

# Shared Google Drive infrastructure. Each person's import source and folder
# IDs belong in ~/Documents/zdrowskit/profiles.toml.
# ZDROWSKIT_GOOGLE_DRIVE_SERVICE_ACCOUNT=~/Documents/zdrowskit/secrets/service-account.json
# ZDROWSKIT_GOOGLE_DRIVE_POLL_INTERVAL_S=300

# Shared Telegram bot. Numeric user IDs belong in profiles.toml.
TELEGRAM_BOT_TOKEN=

# Legacy single-profile values. Keep these only until `profile adopt NAME`
# has copied them into profiles.toml, then remove them.
# TELEGRAM_CHAT_ID=
# ZDROWSKIT_IMPORT_SOURCE=local
# ZDROWSKIT_GOOGLE_DRIVE_METRICS_FOLDER_ID=
# ZDROWSKIT_GOOGLE_DRIVE_WORKOUTS_FOLDER_ID=

# Optional email delivery via Resend.
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM="zdrowskit <onboarding@resend.dev>"

# Optional model overrides. See README.md for the full routing table.
# ZDROWSKIT_INSIGHTS_MODEL=deepseek/deepseek-v4-pro
# ZDROWSKIT_CHAT_MODEL=anthropic/claude-opus-4-8

# Workout locality lookup during import. Set to "off" to skip reverse geocoding.
# ZDROWSKIT_LOCATION_GEOCODER=nominatim
# ZDROWSKIT_LOCATION_COORD_DECIMALS=2
# ZDROWSKIT_LOCATION_MIN_REQUEST_INTERVAL_S=1.1
# ZDROWSKIT_LOCATION_USER_AGENT=zdrowskit/0.1 personal health import
